<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/dot_live"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/dot_live"
            android:contentDescription="Live" />

        <TextView
            android:id="@+id/txt_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="HL VAULT MONITOR"
            android:textColor="#e6edf3"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_vault_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HL Vault"
            android:textColor="#e6edf3"
            android:textSize="11sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <View
        android:id="@+id/divider_head"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1d2733"
        android:layout_below="@id/header_layout"
        android:layout_marginTop="10dp" />

    <!-- Grid 2x2 -->
    <LinearLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/divider_head"
        android:layout_marginTop="8dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/lbl_tvl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TVL"
                    android:textColor="#7d8590"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/val_tvl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0"
                    android:textColor="#e6edf3"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/lbl_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAST MONTH RETURN"
                    android:textColor="#7d8590"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/val_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.00%"
                    android:textColor="#3fe081"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">
                <TextView
                    android:id="@+id/lbl_deposits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR DEPOSITS"
                    android:textColor="#7d8590"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/val_deposits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="#e6edf3"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/lbl_earned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL-TIME EARNED"
                    android:textColor="#7d8590"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/val_earned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+$0.00"
                    android:textColor="#3fe081"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider_meta"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1d2733"
        android:layout_below="@id/grid_container"
        android:layout_marginTop="8dp" />

    <!-- Meta row -->
    <LinearLayout
        android:id="@+id/meta_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_below="@id/divider_meta"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/txt_wallet_short"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WALLET —"
            android:textColor="#7d8590"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txt_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ››› "
            android:textColor="#3fe081"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txt_vault_short"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="VAULT —"
            android:textColor="#7d8590"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/txt_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="UPDATED --:-- · AUTO-REFRESH HOURLY ⟳"
        android:textColor="#7d8590"
        android:textSize="9sp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="4dp" />
</RelativeLayout>
